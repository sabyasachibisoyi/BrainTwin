# BrainTwin Environment Variables
# Copy this file to .env and fill in your values

# ----- Phase 4.0.6 M.1 — bearer token (REQUIRED) ---------------------
# Shared secret. /capture, /recall, /stats, /failures require it.
# /, /health stay public.
#
# Generate a strong one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# In cloud, this is fetched from SSM Parameter Store at boot; this
# .env path is for local docker-compose only.
BACKEND_BEARER_TOKEN=replace-me-with-a-long-random-string

# ----- Phase 4.1 M.M.1.c — per-user auth (OAuth + JWT) ----------------
# JWT signing secret (REQUIRED once routes use get_current_user).
# Minimum 32 chars — enforced at startup. Generate with:
#   openssl rand -hex 32
# Rotating it signs EVERY user out at once (hard reset only).
# In cloud this comes from SSM /braintwin/jwt_secret.
JWT_SECRET=

# JWT lifetime for web sign-ins, in minutes. Default 43200 (30 days).
# The bot mints its own short-lived tokens and ignores this.
JWT_TTL_MINUTES=43200

# Google OAuth 2.0 client (console.cloud.google.com → Credentials).
# client_id is public; client_secret is NOT — keep it out of git.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Where Google redirects after consent. Must EXACTLY match an
# authorized redirect URI on the OAuth client. Local default works
# out of the box; in cloud set https://<your-domain>/auth/google/callback
# (SSM /braintwin/google_oauth_redirect_uri).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Hidden onboarding slug for /join/<slug> (share privately with
# friends). Empty = the /join route 404s unconditionally (fail closed).
# Generate with: openssl rand -base64 24 | tr '+/' '-_' | tr -d '='
JOIN_SLUG=

# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Telegram Bot Token
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram allowlist
# Comma-separated Telegram user IDs that the bot will accept messages from.
# Send /start to your bot once after creating it — it will DM you your own
# user ID, which you can paste here.
ALLOWED_TELEGRAM_USER_IDS=

# Where the bot POSTs captures (same machine in Phase 1)
BACKEND_CAPTURE_URL=http://127.0.0.1:8000/capture

# Telegram bot state file (pause flag + last-seen timestamp)
TELEGRAM_STATE_PATH=./data/telegram_state.json

# Persistent capture-failure log (used by both Chrome and Telegram clients)
CAPTURE_FAILURES_PATH=./data/capture_failures.jsonl

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Phase 4.0.6 M.4.1 — auto-generated API docs (/docs, /redoc, /openapi.json)
# are DISABLED by default because they leak the full API schema and give
# scanners a free enumeration of every route. Set to 1 to flip them back
# on for local development; leave unset (or anything other than 1) in
# production.
BRAINTWIN_DOCS_ENABLED=

# Phase 4.0.6 M.7.a — CORS is intentionally allow_origins=["*"].
# Content scripts run in the page's origin (https://nytimes.com etc.),
# not the extension's chrome-extension://, so locking down to extension
# origins would 405 every capture. The bearer-token-in-header is the
# load-bearing auth (browsers don't auto-attach Authorization headers
# cross-origin → no CSRF). No env flag here.

# Capture Settings
DWELL_TIME_THRESHOLD=30

# LLM Models
ENRICHMENT_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-4-6

# Database Paths
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/braintwin.db
IMAGES_PATH=./data/images
